# Documentation only: enter real values in hPanel's protected environment settings.
# This intentionally incomplete template cannot connect until the owner approves and supplies all IDs.
NODE_ENV=production
HOST=0.0.0.0
# Use Hostinger's assigned PORT; do not replace an injected port.
PORT=3001
HOSTINGER_BACKGROUND_MODE=continuous
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_PASSWORD@REPLACE_SESSION_POOLER_HOST:5432/postgres
DB_CONNECTION_MODE=session
DB_SSL_MODE=require
DB_POOL_MAX=5
# Optional PEM trusted CA if the provider requires it; otherwise use system CA trust.
DB_CA_CERT=
# Optional alternative: one-line Base64 of downloaded Supabase CA certificate.
# Use either DB_CA_CERT or DB_CA_CERT_BASE64, not both.
DB_CA_CERT_BASE64=
SESSION_PEPPER=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PASSWORD_PEPPER=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PAYMENT_PROVIDER=mock
PAYMENTS_ENABLED=false
PROVIDER_APPROVAL_CONFIRMED=false
DISCORD_ENVIRONMENT=production
DISCORD_GUILD_ID=
DISCORD_PRODUCTION_GUILD_ID=
DISCORD_GUILD_OWNER_ID=
DISCORD_CLIENT_ID=
DISCORD_FREE_MEMBER_ROLE_ID=
DISCORD_VIP_MONTHLY_ROLE_ID=
DISCORD_VIP_LIFETIME_ROLE_ID=
DISCORD_FOUNDER_ROLE_ID=
DISCORD_STAFF_ROLE_ID=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_SECRET=
DISCORD_INTERACTIONS_PUBLIC_KEY=
DISCORD_OAUTH_REDIRECT_URI=https://bot.timonconfigs.com/api/discord/callback
DISCORD_SUPPORT_URL=https://timonconfigs.com
DISCORD_OWNER_APPROVED=false
DISCORD_APPROVAL_REFERENCE=
DISCORD_NETWORK_ENABLED=false
DISCORD_DRY_RUN=true
DISCORD_WRITES_ENABLED=false
DISCORD_FREE_MEMBER_WRITES_APPROVED=false
DISCORD_FREE_MEMBER_APPROVAL_REFERENCE=
DISCORD_PRODUCTION_VIP_WRITES_ENABLED=false
DISCORD_VIP_SYNC_ENABLED=false
DISCORD_COMMANDS_ENABLED=false
DISCORD_VERIFICATION_ENABLED=true
DISCORD_GATEWAY_ENABLED=false
DISCORD_WORKER_POLL_MS=1000
DISCORD_WORKER_BATCH_SIZE=5
DISCORD_RECONCILE_SECONDS=300
DISCORD_RECONCILE_BATCH_SIZE=25
DISCORD_MIN_REQUEST_MS=250
DISCORD_LEASE_SECONDS=120
DISCORD_MAX_ATTEMPTS=8
# Cron fallback only: change background mode to cron, keep Gateway disabled.
CRON_MAX_TICKS=3
CRON_MAX_DURATION_MS=45000
CRON_EXPECTED_INTERVAL_SECONDS=300
DISCORD_ADAPTER=rest
