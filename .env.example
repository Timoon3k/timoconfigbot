# PHASE 2 OFFLINE DEVELOPMENT / TEST ONLY. Never commit real secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://timonconfigs:timonconfigs_dev@localhost:5432/timonconfigs
TEST_DATABASE_URL=postgresql://timonconfigs:timonconfigs_dev@localhost:5432/timonconfigs_test

# Generate separate random values with at least 32 characters for each environment.
SESSION_PEPPER=replace-with-at-least-32-random-characters
PASSWORD_PEPPER=replace-with-another-32-random-characters

# Payments remain sandbox simulations only.
PAYMENT_PROVIDER=mock
PAYMENTS_ENABLED=false
PROVIDER_APPROVAL_CONFIRMED=false

# Offline defaults. These synthetic IDs refer to local fixtures, not a real guild.
DISCORD_ADAPTER=mock
DISCORD_DRY_RUN=true
DISCORD_WRITES_ENABLED=false
DISCORD_NETWORK_ENABLED=false
DISCORD_GUILD_ID=100000000000000001
DISCORD_CLIENT_ID=100000000000000002
DISCORD_VIP_MONTHLY_ROLE_ID=100000000000000003
DISCORD_VIP_LIFETIME_ROLE_ID=100000000000000004
DISCORD_FOUNDER_ROLE_ID=100000000000000005
DISCORD_STAFF_ROLE_ID=100000000000000006
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3001/api/discord/callback
# Reserved for a future approved integration. Leave blank for this release.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_SECRET=
# Optional Ed25519 public key for signed interaction contract tests, not a secret.
DISCORD_INTERACTIONS_PUBLIC_KEY=
DISCORD_WORKER_POLL_MS=1000
DISCORD_WORKER_BATCH_SIZE=10
DISCORD_LEASE_SECONDS=120
DISCORD_RECONCILE_SECONDS=3600
DISCORD_RECONCILE_BATCH_SIZE=100
DISCORD_MAX_ATTEMPTS=8
DISCORD_MIN_REQUEST_MS=250

# Staged activation: offline is the default; production is never accepted.
DISCORD_ENVIRONMENT=offline
DISCORD_OWNER_APPROVED=false
DISCORD_APPROVAL_REFERENCE=
DISCORD_TEST_GUILD_ID=
DISCORD_GUILD_OWNER_ID=
DISCORD_GATEWAY_ENABLED=false
DISCORD_VERIFICATION_ENABLED=false
DISCORD_VIP_SYNC_ENABLED=true
DISCORD_FREE_MEMBER_ROLE_ID=100000000000000008
DISCORD_SUPPORT_URL=https://timonconfigs.com
DISCORD_COMMANDS_ENABLED=false
